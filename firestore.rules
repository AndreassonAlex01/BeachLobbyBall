rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /lobbies/{lobbyId} {
      // Any signed-in user (guests included) can see lobbies.
      allow read: if request.auth != null;

      // The creator must be the host and the only player.
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.playerIds == [request.auth.uid];

      // Only the host can delete.
      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid;

      // The host can edit anything except who the host is.
      // Everyone else can only add or remove themselves.
      allow update: if request.auth != null && (
        (resource.data.hostId == request.auth.uid
          && request.resource.data.hostId == resource.data.hostId)
        || isJoining()
        || isLeaving()
      );

      function onlyPlayersChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['playerIds', 'playerNames']);
      }

      function isJoining() {
        let before = resource.data.playerIds;
        let after = request.resource.data.playerIds;
        return onlyPlayersChanged()
          && resource.data.isOpen == true
          && !(request.auth.uid in before)
          && after == before.concat([request.auth.uid])
          && (resource.data.maxPlayers == null || after.size() <= resource.data.maxPlayers);
      }

      function isLeaving() {
        let before = resource.data.playerIds;
        let after = request.resource.data.playerIds;
        return onlyPlayersChanged()
          && request.auth.uid in before
          && request.auth.uid != resource.data.hostId
          && after.toSet() == before.toSet().difference([request.auth.uid].toSet())
          && after.size() == before.size() - 1;
      }

      // Lobby chat. Only players in the lobby can read or write.
      match /messages/{messageId} {
        function lobby() {
          return get(/databases/$(database)/documents/lobbies/$(lobbyId)).data;
        }

        function isPlayer() {
          return request.auth != null && request.auth.uid in lobby().playerIds;
        }

        allow read: if isPlayer();

        allow create: if isPlayer()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        // Senders can delete their own messages, and the host can delete any.
        allow delete: if request.auth != null && (
          resource.data.senderId == request.auth.uid
          || lobby().hostId == request.auth.uid
        );
      }
    }

    // Reports are write-only from the app. Read them in the Firebase console.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid;
    }

    // Each user's block list is private to them.
    match /users/{uid}/blocked/{blockedUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
