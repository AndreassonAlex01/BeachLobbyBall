rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /lobbies/{lobbyId} {
      // Anyone signed in (guests included) can open a lobby they have the id of,
      // for example from an invite. Searching only finds public lobbies and your own.
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && (resource.data.visibility == 'Public' || request.auth.uid in resource.data.playerIds);

      // The creator must be the host and the only player.
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.playerIds == [request.auth.uid];

      // Only the host can delete.
      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid;

      // The host can edit anything, and hand the host role to a player.
      // Everyone else can only add or remove themselves, as a player or on the waitlist.
      allow update: if request.auth != null && (
        (resource.data.hostId == request.auth.uid
          && (request.resource.data.hostId == resource.data.hostId
            || request.resource.data.hostId in resource.data.playerIds))
        || isJoining()
        || isJoiningWaitlist()
        || isLeaving()
        || isLeavingWaitlist()
      );

      function onlyPlayersChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['playerIds', 'playerNames', 'waitlistIds']);
      }

      function waitlistBefore() {
        return resource.data.get('waitlistIds', []);
      }

      function waitlistAfter() {
        return request.resource.data.get('waitlistIds', []);
      }

      // Open, and for private lobbies, the user has an invite (from a friend or the join code).
      function mayEnter() {
        return resource.data.isOpen == true
          && (resource.data.visibility == 'Public' || hasInvite());
      }

      function hasInvite() {
        return exists(/databases/$(database)/documents/invites/$(lobbyId + '_' + request.auth.uid));
      }

      function isFull() {
        return resource.data.maxPlayers != null && resource.data.playerIds.size() >= resource.data.maxPlayers;
      }

      // Taking a free spot. With people waiting, only the first in line may.
      function isJoining() {
        let before = resource.data.playerIds;
        let after = request.resource.data.playerIds;
        return onlyPlayersChanged()
          && mayEnter()
          && !isFull()
          && !(request.auth.uid in before)
          && after == before.concat([request.auth.uid])
          && ((waitlistBefore().size() == 0 && waitlistAfter().size() == 0)
            || (waitlistBefore()[0] == request.auth.uid
              && waitlistAfter() == waitlistBefore().removeAll([request.auth.uid])));
      }

      function isJoiningWaitlist() {
        return onlyPlayersChanged()
          && mayEnter()
          && (isFull() || waitlistBefore().size() > 0)
          && request.resource.data.playerIds == resource.data.playerIds
          && !(request.auth.uid in resource.data.playerIds)
          && !(request.auth.uid in waitlistBefore())
          && waitlistAfter() == waitlistBefore().concat([request.auth.uid]);
      }

      // A player leaves. If someone is waiting, the first in line takes the spot in the same write.
      function isLeaving() {
        let before = resource.data.playerIds;
        let after = request.resource.data.playerIds;
        let remaining = before.removeAll([request.auth.uid]);
        return onlyPlayersChanged()
          && request.auth.uid in before
          && request.auth.uid != resource.data.hostId
          && ((after == remaining && waitlistAfter() == waitlistBefore())
            || (waitlistBefore().size() > 0
              && after == remaining.concat([waitlistBefore()[0]])
              && waitlistAfter() == waitlistBefore().removeAll([waitlistBefore()[0]])));
      }

      function isLeavingWaitlist() {
        return onlyPlayersChanged()
          && request.auth.uid in waitlistBefore()
          && request.resource.data.playerIds == resource.data.playerIds
          && waitlistAfter() == waitlistBefore().removeAll([request.auth.uid]);
      }

      // Lobby chat. Only players in the lobby can read or write.
      match /messages/{messageId} {
        function lobby() {
          return get(/databases/$(database)/documents/lobbies/$(lobbyId)).data;
        }

        function isPlayer() {
          return request.auth != null && request.auth.uid in lobby().playerIds;
        }

        allow read: if isPlayer();

        allow create: if isPlayer()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        // Senders can delete their own messages, and the host can delete any.
        allow delete: if request.auth != null && (
          resource.data.senderId == request.auth.uid
          || lobby().hostId == request.auth.uid
        );
      }
    }

    // Lets people find all their own chat messages, to delete them with their account.
    match /{path=**}/messages/{messageId} {
      allow list: if request.auth != null && resource.data.senderId == request.auth.uid;
    }

    // Lobby invites, stored as {lobbyId}_{toId}.
    match /invites/{inviteId} {
      allow read: if request.auth != null
        && (resource.data.toId == request.auth.uid || resource.data.fromId == request.auth.uid);

      allow create, update: if request.auth != null
        && request.resource.data.fromId == request.auth.uid
        && inviteId == request.resource.data.lobbyId + '_' + request.resource.data.toId
        && (isFriendInvite() || isCodeInvite());

      // The invitee declines or uses it up, or the sender takes it back.
      allow delete: if request.auth != null
        && (resource.data.toId == request.auth.uid || resource.data.fromId == request.auth.uid);

      // A player in the lobby invites one of their friends.
      function isFriendInvite() {
        let invite = request.resource.data;
        return isAccount()
          && invite.toId != request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/lobbies/$(invite.lobbyId)).data.playerIds
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(invite.toId));
      }

      // Someone with the lobby's join code lets themselves in.
      function isCodeInvite() {
        let invite = request.resource.data;
        return invite.toId == request.auth.uid
          && invite.code is string
          && get(/databases/$(database)/documents/lobbyCodes/$(invite.code)).data.lobbyId == invite.lobbyId;
      }
    }

    // Join codes for private lobbies. Look one up by its code; they can't be listed.
    match /lobbyCodes/{code} {
      allow get: if request.auth != null;

      // Written together with the lobby, by its host.
      allow create: if request.auth != null
        && getAfter(/databases/$(database)/documents/lobbies/$(request.resource.data.lobbyId)).data.hostId == request.auth.uid
        && getAfter(/databases/$(database)/documents/lobbies/$(request.resource.data.lobbyId)).data.joinCode == code;

      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/lobbies/$(resource.data.lobbyId)).data.hostId == request.auth.uid;
    }

    // Reports are write-only from the app. Read them in the Firebase console.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid;
    }

    // Each user's block list is private to them.
    match /users/{uid}/blocked/{blockedUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    function isAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Public profiles, readable by anyone signed in. Only accounts have one.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isAccount() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.nameLower == request.resource.data.name.lower();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Exact-email lookup. You can read an entry only if you already know the email.
    match /emailIndex/{email} {
      allow get: if request.auth != null;
      allow create, update: if isAccount()
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email is string
        && email == request.auth.token.email.lower().replace('/', '_');
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Friend requests, stored as {fromId}_{toId}.
    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if isAccount()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toId;
      // The sender can cancel and the receiver can decline or accept.
      allow delete: if request.auth != null
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    // Friend lists. Tags on a friend are private to the list's owner.
    match /users/{uid}/friends/{friendUid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;

      // Accepting a request from friendUid to uid writes both sides at once,
      // so the accepter may also create the entry in the sender's list.
      allow create: if request.auth != null && (
        (request.auth.uid == uid
          && exists(/databases/$(database)/documents/friendRequests/$(friendUid + '_' + uid)))
        || (request.auth.uid == friendUid
          && request.resource.data.tags.size() == 0
          && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid)))
      );

      // Either friend can end the friendship.
      allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
    }
  }
}
